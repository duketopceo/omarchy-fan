#!/usr/bin/env python3
"""Write the requested Omarchy fan mode and optional custom curve."""

import json
import os
import stat
import sys
from pathlib import Path

PRESETS = {
    "silent": [[0, 0], [30, 50], [40, 80], [50, 115], [60, 150], [70, 195], [80, 255]],
    "balanced": [[0, 0], [30, 80], [40, 120], [50, 160], [60, 200], [70, 240], [80, 255]],
    "performance": [[0, 0], [25, 100], [35, 160], [45, 210], [55, 255]],
}


def runtime_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = os.path.join(os.path.expanduser("~"), ".local", "run")
    d = Path(base) / "omarchy-fan"
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    return d


def mode_path() -> Path:
    return runtime_dir() / "current_fan_mode"


def _secure_write(path: Path, content: str) -> None:
    # Open with O_NOFOLLOW to avoid a pre-positioned symlink, O_CREAT to make
    # the file if absent, O_TRUNC to overwrite, O_WRONLY to write. Mode 0600.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(f"{path} is not a regular file")
        if st.st_uid != os.getuid():
            raise OSError(f"{path} is not owned by the current user")
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        raise


def write_mode(mode: str) -> None:
    _secure_write(mode_path(), mode)


def write_curve(points: list[list[int]]) -> None:
    home = Path.home()
    path = home / ".config" / "omarchy" / "fan_curve.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(points, fh)


def main(argv: list[str]) -> None:
    if not argv:
        write_mode("auto")
        return

    first = argv[0].lower()

    if first == "custom":
        name = argv[1].lower() if len(argv) > 1 else ""
        if name in PRESETS:
            write_curve(PRESETS[name])
        write_mode("custom")
        return

    if first in {"auto", "low", "med", "high"}:
        write_mode(first)
        return

    # Allow e.g. "silent" to mean "custom + silent curve"
    if first in PRESETS:
        write_curve(PRESETS[first])
        write_mode("custom")
        return

    write_mode("auto")


if __name__ == "__main__":
    main(sys.argv[1:])
