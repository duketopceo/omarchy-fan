#!/usr/bin/python3
"""Write the requested Omarchy fan mode and optional custom curve."""

import json
import os
import stat
import sys
from pathlib import Path

PRESETS = {
    "silent": [[0, 0], [30, 50], [40, 80], [50, 115], [60, 150], [70, 195], [80, 255]],
    "balanced": [[0, 0], [30, 80], [40, 120], [50, 160], [60, 200], [70, 240], [80, 255]],
    "performance": [[0, 0], [25, 100], [35, 160], [45, 210], [55, 255]],
}


def _open_dir(path) -> int:
    """Descriptor for a directory — no symlinks, must be ours."""
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        os.close(fd)
        raise PermissionError(f"{path} is not a user-owned real directory")
    return fd


def _publish(dirfd: int, name: str, content: bytes) -> None:
    """Write via exclusive same-dir temp file + atomic descriptor-relative rename."""
    tmp = f".{name}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dirfd)
    try:
        os.write(fd, content)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)


def runtime_dirfd() -> int:
    """Create if needed, then return a verified descriptor for the runtime dir."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = os.path.join(os.path.expanduser("~"), ".local", "run")
    target = os.path.join(base, "omarchy-fan")
    try:
        os.mkdir(target, 0o700)
    except FileExistsError:
        pass
    fd = _open_dir(target)
    st = os.fstat(fd)
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.fchmod(fd, 0o700)
    return fd


def write_mode(mode: str) -> None:
    dirfd = runtime_dirfd()
    try:
        _publish(dirfd, "current_fan_mode", mode.encode())
    finally:
        os.close(dirfd)


def write_curve(points: list[list[int]]) -> None:
    parent = Path.home() / ".config" / "omarchy"
    parent.mkdir(parents=True, exist_ok=True)
    dirfd = _open_dir(parent)
    try:
        _publish(dirfd, "fan_curve.json", json.dumps(points).encode())
    finally:
        os.close(dirfd)


def main(argv: list[str]) -> None:
    if not argv:
        write_mode("auto")
        return

    first = argv[0].lower()

    if first == "custom":
        name = argv[1].lower() if len(argv) > 1 else ""
        if name in PRESETS:
            write_curve(PRESETS[name])
        write_mode("custom")
        return

    if first in {"auto", "low", "med", "high"}:
        write_mode(first)
        return

    # Allow e.g. "silent" to mean "custom + silent curve"
    if first in PRESETS:
        write_curve(PRESETS[first])
        write_mode("custom")
        return

    write_mode("auto")


if __name__ == "__main__":
    main(sys.argv[1:])
