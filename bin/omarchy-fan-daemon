#!/usr/bin/python3
"""Omarchy Fan Daemon: auto-curve, fixed presets, and a custom temperature curve."""

from __future__ import annotations

import glob
import json
import os
import stat
import time
from pathlib import Path


DEFAULT_CURVE = [
    [0, 0],
    [35, 80],
    [45, 120],
    [55, 170],
    [65, 210],
    [75, 255],
]


def config_home() -> Path:
    env = os.environ.get("XDG_CONFIG_HOME")
    if env:
        return Path(env)
    return Path.home() / ".config"


def curve_path() -> Path:
    base = config_home() / "omarchy" / "fan_curve.json"
    if base.is_file():
        return base
    for u in glob.glob("/home/*/.config/omarchy/fan_curve.json"):
        if os.path.isfile(u):
            return Path(u)
    return base


def runtime_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = os.path.join(os.path.expanduser("~"), ".local", "run")
    d = Path(base) / "omarchy-fan"
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    return d


def mode_path() -> Path:
    user_modes = glob.glob("/run/user/*/omarchy-fan/current_fan_mode")
    if user_modes:
        user_modes.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        return Path(user_modes[0])
    return runtime_dir() / "current_fan_mode"


def get_hwmon() -> tuple[str, Path | None]:
    for name_file in glob.glob("/sys/class/hwmon/hwmon*/name"):
        try:
            content = Path(name_file).read_text().strip()
            if content == "macsmc_hwmon":
                return "macsmc", Path(name_file).parent
            elif "dell_smm" in content:
                return "dell", Path(name_file).parent
        except OSError:
            continue
    return "unknown", None


def get_max_temp() -> int:
    temps: list[int] = []
    for temp_file in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            with open(temp_file, "r") as f:
                val = int(f.read().strip())
                if val > 1000:
                    val = round(val / 1000)
                if 10 <= val <= 115:
                    temps.append(val)
        except (OSError, ValueError):
            continue

    for temp_file in glob.glob("/sys/class/hwmon/hwmon*/temp*_input"):
        try:
            with open(temp_file, "r") as f:
                val = round(int(f.read().strip()) / 1000)
                if 10 <= val <= 115:
                    temps.append(val)
        except (OSError, ValueError):
            continue

    return max(temps) if temps else 50


def is_on_ac() -> bool:
    for ac_file in glob.glob("/sys/class/power_supply/*ac*/online"):
        try:
            with open(ac_file, "r") as f:
                if f.read().strip() == "1":
                    return True
        except OSError:
            continue
    for bat_status in glob.glob("/sys/class/power_supply/*bat*/status"):
        try:
            with open(bat_status, "r") as f:
                status = f.read().strip().lower()
                if status in {"charging", "full", "not charging"}:
                    return True
        except OSError:
            continue
    return False


def set_platform_profile(profile: str) -> None:
    path = Path("/sys/firmware/acpi/platform_profile")
    if not path.is_file():
        return
    try:
        current = path.read_text().strip()
        if current != profile:
            path.write_text(profile)
    except OSError:
        pass


def set_fan_speed(hw_type: str, hwmon: Path | None, pwm_val: int) -> None:
    if not hwmon:
        return

    if hw_type == "macsmc":
        ctrl_param = Path("/sys/module/macsmc_hwmon/parameters/fan_control")
        if ctrl_param.is_file():
            try:
                if pwm_val == 0:
                    if ctrl_param.read_text().strip() != "N":
                        ctrl_param.write_text("N")
                else:
                    if ctrl_param.read_text().strip() != "Y":
                        ctrl_param.write_text("Y")
            except OSError:
                pass

        if pwm_val == 0:
            for target_name in ("fan1_target", "fan2_target"):
                try:
                    (hwmon / target_name).write_text("0")
                except OSError:
                    pass
            return

        def _get_limit(p: Path, default: int) -> int:
            try:
                return int(p.read_text().strip())
            except (OSError, ValueError):
                return default

        f1_min, f1_max = _get_limit(hwmon / "fan1_min", 1499), _get_limit(hwmon / "fan1_max", 4296)
        f2_min, f2_max = _get_limit(hwmon / "fan2_min", 1499), _get_limit(hwmon / "fan2_max", 4744)

        ratio = max(0.0, min(1.0, pwm_val / 255.0))
        target1 = round(f1_min + (f1_max - f1_min) * ratio)
        target2 = round(f2_min + (f2_max - f2_min) * ratio)

        try:
            (hwmon / "fan1_target").write_text(str(target1))
        except OSError:
            pass
        try:
            (hwmon / "fan2_target").write_text(str(target2))
        except OSError:
            pass

    elif hw_type == "dell":
        for pwm_name, enable_name in [("pwm1", "pwm1_enable"), ("pwm2", "pwm2_enable")]:
            try:
                en_path = hwmon / enable_name
                if en_path.is_file():
                    en_path.write_text("1")
            except OSError:
                pass
            try:
                p_path = hwmon / pwm_name
                if p_path.is_file():
                    p_path.write_text(str(max(0, min(255, pwm_val))))
            except OSError:
                pass


def get_requested_mode() -> str:
    path = mode_path()
    if not path.is_file():
        return "auto"
    try:
        # Open with O_NOFOLLOW to avoid following a symlink placed by another user.
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (os.getuid() != 0 and st.st_uid != os.getuid()):
            os.close(fd)
            return "auto"
        with os.fdopen(fd, "r") as fh:
            mode = fh.read().strip().lower()
        if mode in {"auto", "low", "med", "high", "custom"} or mode.startswith("custom-"):
            return mode
    except OSError:
        pass
    return "auto"


def load_curve() -> list[list[int]]:
    path = curve_path()
    if not path.is_file():
        return DEFAULT_CURVE
    try:
        data = json.loads(path.read_text())
        if isinstance(data, list) and all(isinstance(p, list) and len(p) == 2 for p in data):
            return [[int(p[0]), int(p[1])] for p in data]
    except (OSError, ValueError):
        pass
    return DEFAULT_CURVE


def curve_pwm(temp: int, curve: list[list[int]]) -> int:
    """Linearly interpolate a PWM for the given temp from (temp, pwm) points."""
    if not curve:
        return 0
    # ensure sorted by temperature
    curve = sorted(curve, key=lambda p: p[0])
    if temp <= curve[0][0]:
        return curve[0][1]
    if temp >= curve[-1][0]:
        return curve[-1][1]
    for i in range(len(curve) - 1):
        t1, p1 = curve[i]
        t2, p2 = curve[i + 1]
        if t1 <= temp <= t2:
            if t2 == t1:
                return p1
            return round(p1 + (p2 - p1) * (temp - t1) / (t2 - t1))
    return curve[-1][1]


def main() -> None:
    hw_type, hwmon = get_hwmon()
    while True:
        mode = get_requested_mode()
        temp = get_max_temp()
        on_ac = is_on_ac()

        if mode == "auto":
            if hw_type == "macsmc":
                set_fan_speed(hw_type, hwmon, 0)
            else:
                if on_ac:
                    if temp >= 58:
                        set_platform_profile("cool")
                        set_fan_speed(hw_type, hwmon, 255)
                    elif temp >= 52:
                        set_platform_profile("cool")
                        set_fan_speed(hw_type, hwmon, 204)
                    elif temp <= 48:
                        set_platform_profile("balanced")
                        set_fan_speed(hw_type, hwmon, 140)
                else:
                    if temp >= 65:
                        set_platform_profile("cool")
                        set_fan_speed(hw_type, hwmon, 230)
                    elif temp >= 58:
                        set_platform_profile("balanced")
                        set_fan_speed(hw_type, hwmon, 170)
                    elif temp <= 52:
                        set_platform_profile("quiet")
                        set_fan_speed(hw_type, hwmon, 100)

        elif mode == "low":
            set_platform_profile("quiet")
            set_fan_speed(hw_type, hwmon, 128)

        elif mode == "med":
            set_platform_profile("balanced")
            set_fan_speed(hw_type, hwmon, 204)

        elif mode == "high":
            set_platform_profile("cool")
            set_fan_speed(hw_type, hwmon, 255)

        elif mode == "custom" or mode.startswith("custom-"):
            curve = load_curve()
            pwm = curve_pwm(temp, curve)
            if temp >= 65:
                set_platform_profile("cool")
            elif temp >= 55:
                set_platform_profile("balanced")
            else:
                set_platform_profile("quiet")
            set_fan_speed(hw_type, hwmon, pwm)

        time.sleep(2)


if __name__ == "__main__":
    main()
