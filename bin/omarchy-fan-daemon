#!/usr/bin/python3
"""Omarchy Fan Daemon: auto-curve, fixed presets, and a custom temperature curve."""

from __future__ import annotations

import glob
import json
import os
import stat
import sys
import time
from pathlib import Path


DEFAULT_CURVE = [
    [0, 0],
    [35, 80],
    [45, 120],
    [55, 170],
    [65, 210],
    [75, 255],
]

# God-to-great auto curve: aggressively keeps temperatures in low 50s and below
AUTO_CURVE = [
    [0, 0],
    [36, 40],    # ~1500-1900 RPM whisper baseline
    [40, 75],    # ~2200-2400 RPM gentle proactive cooling
    [44, 120],   # ~2800-3000 RPM active thermal rejection
    [48, 175],   # ~3400-3700 RPM aggressive ramp before 50°C
    [51, 220],   # ~3900-4300 RPM high power to cap temperatures
    [54, 255],   # 100% full blast to crush heat spikes
]


def target_uid() -> int:
    """Explicit target UID: via --uid arg, OMARCHY_FAN_UID env, SUDO_UID env, or current UID."""
    for i, arg in enumerate(sys.argv[:-1]):
        if arg == "--uid":
            try:
                return int(sys.argv[i + 1])
            except ValueError:
                pass
    env = os.environ.get("OMARCHY_FAN_UID") or os.environ.get("SUDO_UID")
    if env:
        try:
            return int(env)
        except ValueError:
            pass
    uid = os.getuid()
    if uid != 0:
        return uid
    # When running as root, detect active user session from /run/user
    try:
        run_users = [int(p.name) for p in Path("/run/user").glob("[0-9]*") if p.is_dir() and int(p.name) >= 1000]
        if run_users:
            return sorted(run_users)[0]
    except (OSError, ValueError):
        pass
    return 1001


def get_hwmon() -> tuple[str, Path | None]:
    for name_file in glob.glob("/sys/class/hwmon/hwmon*/name"):
        try:
            content = Path(name_file).read_text().strip()
            if content == "macsmc_hwmon":
                return "macsmc", Path(name_file).parent
            elif "dell_smm" in content:
                return "dell", Path(name_file).parent
        except OSError:
            continue
    return "unknown", None


def get_max_temp() -> int:
    temps: list[int] = []
    for temp_file in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            with open(temp_file, "r") as f:
                val = int(f.read().strip())
                if val > 1000:
                    val = round(val / 1000)
                if 10 <= val <= 115:
                    temps.append(val)
        except (OSError, ValueError):
            continue

    for temp_file in glob.glob("/sys/class/hwmon/hwmon*/temp*_input"):
        try:
            with open(temp_file, "r") as f:
                val = round(int(f.read().strip()) / 1000)
                if 10 <= val <= 115:
                    temps.append(val)
        except (OSError, ValueError):
            continue

    return max(temps) if temps else 50


def is_on_ac() -> bool:
    for ac_file in glob.glob("/sys/class/power_supply/*ac*/online"):
        try:
            with open(ac_file, "r") as f:
                if f.read().strip() == "1":
                    return True
        except OSError:
            continue
    for bat_status in glob.glob("/sys/class/power_supply/*bat*/status"):
        try:
            with open(bat_status, "r") as f:
                status = f.read().strip().lower()
                if status in {"charging", "full", "not charging"}:
                    return True
        except OSError:
            continue
    return False


def set_platform_profile(profile: str) -> None:
    path = Path("/sys/firmware/acpi/platform_profile")
    if not path.is_file():
        return
    try:
        current = path.read_text().strip()
        if current != profile:
            path.write_text(profile)
    except OSError:
        pass


def set_fan_speed(hw_type: str, hwmon: Path | None, pwm_val: int) -> None:
    if not hwmon:
        return

    if hw_type == "macsmc":
        ctrl_param = Path("/sys/module/macsmc_hwmon/parameters/fan_control")
        if ctrl_param.is_file():
            try:
                if pwm_val == 0:
                    if ctrl_param.read_text().strip() != "N":
                        ctrl_param.write_text("N")
                else:
                    if ctrl_param.read_text().strip() != "Y":
                        ctrl_param.write_text("Y")
            except OSError:
                pass

        if pwm_val == 0:
            for target_name in ("fan1_target", "fan2_target"):
                try:
                    (hwmon / target_name).write_text("0")
                except OSError:
                    pass
            return

        def _get_limit(p: Path, default: int) -> int:
            try:
                return int(p.read_text().strip())
            except (OSError, ValueError):
                return default

        f1_min, f1_max = _get_limit(hwmon / "fan1_min", 1499), _get_limit(hwmon / "fan1_max", 4296)
        f2_min, f2_max = _get_limit(hwmon / "fan2_min", 1499), _get_limit(hwmon / "fan2_max", 4744)

        ratio = max(0.0, min(1.0, pwm_val / 255.0))
        target1 = round(f1_min + (f1_max - f1_min) * ratio)
        target2 = round(f2_min + (f2_max - f2_min) * ratio)

        try:
            os.chmod(hwmon / "fan1_target", 0o644)
        except OSError:
            pass
        try:
            (hwmon / "fan1_target").write_text(str(target1))
        except OSError:
            pass
        try:
            os.chmod(hwmon / "fan2_target", 0o644)
        except OSError:
            pass
        try:
            (hwmon / "fan2_target").write_text(str(target2))
        except OSError:
            pass

    elif hw_type == "dell":
        for pwm_name, enable_name in [("pwm1", "pwm1_enable"), ("pwm2", "pwm2_enable")]:
            try:
                en_path = hwmon / enable_name
                if en_path.is_file():
                    en_path.write_text("1")
            except OSError:
                pass
            try:
                p_path = hwmon / pwm_name
                if p_path.is_file():
                    p_path.write_text(str(max(0, min(255, pwm_val))))
            except OSError:
                pass


def get_requested_mode(uid: int | None = None) -> str:
    if uid is None:
        uid = target_uid()
    rdir = Path(f"/run/user/{uid}/omarchy-fan")
    if not rdir.is_dir():
        try:
            import pwd
            home = Path(pwd.getpwuid(uid).pw_dir)
            rdir = home / ".local" / "run" / "omarchy-fan"
        except (KeyError, ImportError):
            pass

    try:
        dfd = os.open(rdir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return "auto"

    try:
        dst = os.fstat(dfd)
        if not stat.S_ISDIR(dst.st_mode) or dst.st_uid != uid:
            return "auto"
        try:
            ffd = os.open("current_fan_mode", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
        except OSError:
            return "auto"
        try:
            fst = os.fstat(ffd)
            if not stat.S_ISREG(fst.st_mode) or fst.st_uid != uid or fst.st_size > 64:
                return "auto"
            data = os.read(ffd, 64).decode("utf-8", errors="replace").strip().lower()
            if data in {"auto", "low", "med", "high", "custom"} or data.startswith("custom-"):
                return data
        finally:
            os.close(ffd)
    finally:
        os.close(dfd)

    return "auto"


def load_curve(uid: int | None = None) -> list[list[int]]:
    if uid is None:
        uid = target_uid()
    try:
        import pwd
        home = Path(pwd.getpwuid(uid).pw_dir)
        cdir = home / ".config" / "omarchy"
    except (KeyError, ImportError):
        return DEFAULT_CURVE

    try:
        dfd = os.open(cdir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return DEFAULT_CURVE

    try:
        dst = os.fstat(dfd)
        if not stat.S_ISDIR(dst.st_mode) or dst.st_uid != uid:
            return DEFAULT_CURVE
        try:
            ffd = os.open("fan_curve.json", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
        except OSError:
            return DEFAULT_CURVE
        try:
            fst = os.fstat(ffd)
            if not stat.S_ISREG(fst.st_mode) or fst.st_uid != uid or fst.st_size > 65536:
                return DEFAULT_CURVE
            raw = os.read(ffd, 65536).decode("utf-8", errors="replace")
            data = json.loads(raw)
            if isinstance(data, list) and all(isinstance(p, list) and len(p) == 2 for p in data):
                return [[int(p[0]), int(p[1])] for p in data]
        except (OSError, ValueError):
            pass
        finally:
            os.close(ffd)
    finally:
        os.close(dfd)

    return DEFAULT_CURVE


def curve_pwm(temp: int, curve: list[list[int]]) -> int:
    """Linearly interpolate a PWM for the given temp from (temp, pwm) points."""
    if not curve:
        return 0
    # ensure sorted by temperature
    curve = sorted(curve, key=lambda p: p[0])
    if temp <= curve[0][0]:
        return curve[0][1]
    if temp >= curve[-1][0]:
        return curve[-1][1]
    for i in range(len(curve) - 1):
        t1, p1 = curve[i]
        t2, p2 = curve[i + 1]
        if t1 <= temp <= t2:
            if t2 == t1:
                return p1
            return round(p1 + (p2 - p1) * (temp - t1) / (t2 - t1))
    return curve[-1][1]


def main() -> None:
    hw_type, hwmon = get_hwmon()
    uid = target_uid()
    while True:
        mode = get_requested_mode(uid)
        temp = get_max_temp()
        on_ac = is_on_ac()

        if mode == "auto":
            # God-to-great auto curve: proactively cools to maintain low 50s and below
            pwm = curve_pwm(temp, AUTO_CURVE)
            if temp >= 52:
                set_platform_profile("cool")
            elif temp >= 45:
                set_platform_profile("balanced")
            else:
                set_platform_profile("quiet")
            set_fan_speed(hw_type, hwmon, pwm)

        elif mode == "low":
            set_platform_profile("quiet")
            set_fan_speed(hw_type, hwmon, 128)

        elif mode == "med":
            set_platform_profile("balanced")
            set_fan_speed(hw_type, hwmon, 204)

        elif mode == "high":
            set_platform_profile("cool")
            set_fan_speed(hw_type, hwmon, 255)

        elif mode == "custom" or mode.startswith("custom-"):
            curve = load_curve(uid)
            pwm = curve_pwm(temp, curve)
            if temp >= 65:
                set_platform_profile("cool")
            elif temp >= 55:
                set_platform_profile("balanced")
            else:
                set_platform_profile("quiet")
            set_fan_speed(hw_type, hwmon, pwm)

        time.sleep(2)


if __name__ == "__main__":
    main()
